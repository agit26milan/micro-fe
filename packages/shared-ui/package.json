{
  "name": "@mfe-store/shared-ui",
  "version": "0.1.0",
  "private": true,
  "description": "Shared UI components — framework-agnostic Web Components",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles": {
      "import": "./dist/styles.css"
    }
  },
  "scripts": {
    "build": "tsc && cp src/styles/*.css dist/",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "lit": "^3.0.0"
  },
  "devDependencies": {
    "typescript": "^5.0.0"
  }
}
